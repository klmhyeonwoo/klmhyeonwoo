      {
        "type": "code_block",
        "children": [
          {
            "text": "// scheduler.ts (단순화)\nconst queue = []\n\nfunction queueJob(job) {\n  if (!queue.includes(job)) {\n    queue.push(job)\n  }\n  // 아직 실행 예약 안 됐으면: 마이크로태스크로 예약\n  if (!isFlushPending) {\n    isFlushPending = true\n    Promise.resolve().then(flushJobs)  // ← 동기 코드가 전부 끝난 직후 실행\n  }\n}"
          }
        ],
        "lang": "javascript"
      },
      {
        "type": "p",
        "children": [
