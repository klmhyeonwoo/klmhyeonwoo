          {
            "text": "const componentUpdateFn = () => {\n  const nextTree = renderComponentRoot(instance)  // ← 새 vnode 생성\n  const prevTree = instance.subTree               // ← 이전 vnode\n  instance.subTree = nextTree\n  patch(prevTree, nextTree, container)            // ← 비교 후 DOM 업데이트\n}"
