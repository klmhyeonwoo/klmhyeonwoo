  {
    "id": "6d1042f0-d2a2-434b-9a74-aef5d23762ff",
    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": "// 1. 쿼리 생성 시\nconst query = queryCache.build(client, {\n  queryKey: ['todos'],\n  queryFn: fetchTodos\n});\n\n// 2. TanStack Query가 내부적으로 queryFn을 실행\nconst result = await query.options.queryFn();\n\n// 3. 데이터 저장\nquery.state = {\n  data: result,\n  dataUpdatedAt: Date.now();\n  status: 'success'\n}\n\n// 4. staleTime 경과 확인\nconst isStale = Date.now() - query.state.dataUpdatedAt > query.options.staleTime\n\n// 5. gcTime 경과 시에 제거\nif (query.observers.length === 0) {\n  setTimeout(() => {\n    queryCache.remove(query);\n  }, query.options.gcTime)\n}",
        "styles": {}
      }
    ],
    "children": []
  },
