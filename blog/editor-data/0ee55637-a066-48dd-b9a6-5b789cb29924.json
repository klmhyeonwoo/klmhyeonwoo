  {
    "id": "ca6f8eb8-6edc-4ed2-9644-58e169e24665",
    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": "QueryClient\n  └─ QueryCache (Map)\n       ├─ Query['todos']\n       │    ├─ state: { data, dataUpdatedAt, status }\n       │    ├─ observers: [Observer1, Observer2]\n       │    └─ options: { staleTime, gcTime }\n       │\n       └─ Query['user', 1]\n            ├─ state: { data, dataUpdatedAt, status }\n            ├─ observers: []\n            └─ options: { staleTime, gcTime }",
        "styles": {}
      }
    ],
    "children": []
