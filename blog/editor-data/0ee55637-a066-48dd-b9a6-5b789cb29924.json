    "content": [
      {
        "type": "text",
        "text": "persistQueryClient로 localStorage에 직렬화하여 저장하기",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "2829933c-35a7-4ec7-be25-c097f3553e5c",
    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": "import { QueryClient, VueQueryPlugin } from '@tanstack/vue-query';\nimport { persistQueryClient } from '@tanstack/query-persist-client-core';\nimport { createSyncStoragePersister } from '@tanstack/query-sync-storage-persister';\n\n// main.js\nconst queryClient = new QueryClient({\n  defaultOptions: {\n      queries: {\n          staleTime: 1000 * 30 // 30sec\n          gcTime: 1000 * 60 // 60sec\n      }\n  }\n});\n\npersistQueryClient({\n  queryClient,\n  persister: createSyncStoragePersister({ storage: window.localStorage }),\n});\n\n...\n\napp.use(VueQueryPlugin, { queryClient });",
        "styles": {}
      }
    ],
    "children": []
  }
