            "bold": true
          },
          {
            "text": "을 도입했다."
          }
        ]
      },
      {
        "type": "code_block",
        "children": [
          {
            "text": "node_modules/\n  package-a/\n  package-b/     ← 최상위로 끌어올림 (hoisting)\n  package-c/"
