    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "사내 보안 모델을 통해 Agentic UI를 구성하기 위한 A2UI 응답 값이며, 여기서 중점적으로 봐야할 부분들은 component에 관련된 부분입니다. 사실 쉽게 생각하면 SDUI (Server Driven UI) 처럼 동적으로 컴포넌트들을 렌더링하기 위한 키 값들이 존재하고, 이 키 값들을 통해 동적 대응을 할 수 있습니다.",
        "styles": {}
      }
    ],
    "children": []
