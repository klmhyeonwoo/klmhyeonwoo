      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "앞 작업의 결과가 다음 작업에 필요할 때",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "96e068e8-3a55-4abb-8a3e-44b4c33770b9",
    "type": "bulletListItem",
    "props": {
      "backgroundColor": "default",
