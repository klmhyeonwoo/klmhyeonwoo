    "children": []
  },
  {
    "id": "63cec0c6-d14c-4d91-a255-ee051c5a0bf4",
    "type": "bulletListItem",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "결과 순서만 배열 순서대로 받으면 될 때",
