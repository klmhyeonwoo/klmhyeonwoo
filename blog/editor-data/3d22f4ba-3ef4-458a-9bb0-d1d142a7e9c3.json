    },
    "content": [
      {
        "type": "text",
        "text": "API 호출 순서를 보장해야할 때",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "a5d83e56-e98f-46e0-aee0-56da4e9a9b65",
    "type": "bulletListItem",
    "props": {
      "backgroundColor": "default",
