  {
    "id": "ddd3639b-6153-49dd-925c-7d8df98c81f9",
    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": "// useGetAnyInformation.js\nconst useGetAnyInformation = ({ boardId } ) => {\n    const get = () => {\n        const response = api.get(`...?id=${boardId}`);\n        return response?.data;\n    }\n \n    return useQuery({\n        queryKey: ['anyInformation', boardId];\n        queryFn: get\n    })l\n}\n \n// component.vue\n<template>\n    <span> this is information component </span>\n    <button @click=\"() => boardId = boardId += 1;\">\n</template>\n  \n<script setup>\n    import { ref, watch } from 'vue';\n \n    const boardId = ref(0);\n    const { data } = useGetAnyInformation({ boardId: boardId.value });\n</script>",
        "styles": {}
      }
    ],
    "children": []
  },
  {
