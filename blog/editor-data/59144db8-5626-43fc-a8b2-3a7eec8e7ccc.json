      {
        "type": "text",
        "text": " 를 선제적으로 도입을 하고, 단순하고 자주 사용되는 케이스의 컴포넌트라면 ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Flat API",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " 를 사용**해보자.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "73beff17-3432-4e21-bd2d-8b363b9e3026",
