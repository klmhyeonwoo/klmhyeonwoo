        "type": "text",
        "text": "const tx = db.transaction('posts', 'readwrite');\nconst store = tx.objectStore('posts');\n\nawait store.put({ id: 1, title: 'A' });\nawait store.put({ id: 2, title : 'B' });\n\nawait tx.done() // 중요",
