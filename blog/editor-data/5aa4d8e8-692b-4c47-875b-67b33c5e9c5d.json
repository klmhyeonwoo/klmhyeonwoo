  },
  {
    "id": "a50f251c-48b8-4020-93fa-e684bd834c59",
    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": "const cursorReq = store.openCursor();\n\ncursorReq.onsuccess = (e) => {\nconst cursor = e.target.result;\nif (cursor) {\nconsole.log(cursor.value);\ncursor.continue();\n}\n}",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "39a87290-5cae-421c-b34f-133dd88e62d4",
    "type": "heading",
    "props": {
      "backgroundColor": "default",
