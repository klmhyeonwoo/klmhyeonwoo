        "text": "// Form.vue (로드)\n\n<script setup>\nconst { loadContent } = useContentsAutoSave();\n\nonMounted(() => {\nconst { title, contents } = await loadContent('content');\ntitle.value = title;\ncontents.value = contents;\n});\n</script>",
