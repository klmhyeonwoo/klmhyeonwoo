        "text": "request.onupgradeneeded = (e) => {\nconst db = e.target.result;\n\n// ObjectStore 생성 (테이블)\nconst store = db.createObjectStore('post', { keyPath: 'id' });\n\n// 인덱스 생성\nstore.createIndex('by_title', 'title');\n}",
