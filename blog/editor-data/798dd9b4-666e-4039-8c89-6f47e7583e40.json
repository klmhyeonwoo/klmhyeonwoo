            "text": "// 지나치게 체이닝된 코드 — 중간 값이 뭔지 파악하기 어렵다\nconst result = data\n  .flatMap(x => x.items)\n  .filter(item => item.valid)\n  .map(item => ({ ...item, score: item.value * 1.2 }))\n  .sort((a, b) => b.score - a.score)\n  .slice(0, 10)\n  .reduce((acc, item) => ({ ...acc, [item.id]: item }), {});"
