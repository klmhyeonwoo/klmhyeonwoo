      {
        "type": "code_block",
        "children": [
          {
            "text": "차적 ㄹconst allItems = data.flatMap(x => x.items);\nconst validItems = allItems.filter(item => item.valid);\nconst scoredItems = validItems.map(item => ({ ...item, score: item.value * 1.2 }));\nconst topItems = scoredItems.sort((a, b) => b.score - a.score).slice(0, 10);\nconst itemMap = topItems.reduce((acc, item) => ({ ...acc, [item.id]: item }), {});"
          }
