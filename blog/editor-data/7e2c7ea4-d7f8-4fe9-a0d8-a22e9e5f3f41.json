          }
        ]
      },
      {
        "type": "code_block",
        "children": [
          {
            "text": "function createValidatedUser(initial) {\n  return new Proxy(initial, {\n    set(target, key, value) {\n      if (key === 'age' && typeof value !== 'number') {\n        throw new TypeError('age는 숫자여야 합니다')  // ← 쓰기 시점에 검증\n      }\n      if (key === 'email' && !value.includes('@')) {\n        throw new Error('올바른 이메일 형식이 아닙니다')\n      }\n      return Reflect.set(target, key, value)\n    }\n  })\n}\n\nconst user = createValidatedUser({ name: 'Kim', age: 20 })\nuser.age = 'abc'   // ← TypeError 발생\nuser.email = 'invalid'  // ← Error 발생"
          }
        ],
        "lang": "javascript"
      },
      {
        "type": "blockquote",
        "children": [
          {
            "text": "접근 로그가 필요한 객체",
            "bold": true
          }
        ]
      },
      {
        "type": "code_block",
        "children": [
          {
            "text": "function withLogging(target, label) {\n  return new Proxy(target, {\n    get(target, key, receiver) {\n      console.log(`[${label}] get: ${String(key)}`)\n      return Reflect.get(target, key, receiver)\n    },\n    set(target, key, value, receiver) {\n      console.log(`[${label}] set: ${String(key)} = ${JSON.stringify(value)}`)\n      return Reflect.set(target, key, value, receiver)\n    }\n  })\n}\n\nconst config = withLogging({ timeout: 3000 }, 'Config')\nconfig.timeout       // 출력: [Config] get: timeout\nconfig.timeout = 5000  // 출력: [Config] set: timeout = 5000"
          }
        ],
        "lang": "javascript"
      },
      {
        "type": "blockquote",
        "children": [
          {
            "text": "존재하지 않는 프로퍼티에 기본값 제공",
            "bold": true
          }
        ]
      },
      {
        "type": "code_block",
        "children": [
          {
            "text": "const withDefault = (target, defaultValue) =>\n  new Proxy(target, {\n    get(target, key) {\n      return key in target\n        ? Reflect.get(target, key)\n        : defaultValue   // ← 없는 키 접근 시 기본값 반환\n    }\n  })\n\nconst scores = withDefault({}, 0)\nscores.math = 90\nconsole.log(scores.math)     // 90\nconsole.log(scores.english)  // 0 ← 기본값"
          }
        ],
        "lang": "javascript"
      },
      {
        "type": "p",
        "children": [
          {
            "text": "Proxy는 객체 동작을 커스터마이징하는 강력한 도구라고 생각이 든다. Vue의 "
          },
          {
            "text": "reactive()",
            "code": true
          },
          {
            "text": "가 내부적으로 어떻게 동작하는지 알고 나면 프레임워크 코드를 작성할 때마다 내부 동작이 너무 신기하게 느껴지는 것 같다."
          }
        ]
      },
      {
        "type": "p",
        "children": [
          {
            "text": "전에 "
          },
          {
            "text": "Proxy",
            "code": true
          },
          {
            "text": " 가 무엇이냐 질문이 들어왔을 때, "
          },
          {
            "text": "Proxy",
            "code": true
