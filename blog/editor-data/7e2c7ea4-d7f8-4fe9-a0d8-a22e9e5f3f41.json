      {
        "type": "code_block",
        "children": [
          {
            "text": "// React.memo, useMemo, useCallback의 동작 원리\nconst prev = { count: 0 }\nconst next = { count: 0 }\n\nprev === next  // false → 다른 객체이므로 리렌더링\n\n// 불변 업데이트\nconst updated = { ...prev, count: 1 }\nprev === updated  // false → 명확히 다름"
          }
        ],
        "lang": "javascript"
