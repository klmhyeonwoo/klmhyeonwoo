  {
    "id": "e517a4f6-cd49-4b1e-a959-7d1bba7a72dd",
    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": "import fastdom from 'fastdom';\n\n// 읽기는 measure로\nfastdom.measure(() => {\n  const width = element.offsetWidth; // ← 읽기 큐에 쌓임\n\n  // 쓰기는 mutate로\n  fastdom.mutate(() => {\n    element.style.width = width + 10 + 'px'; // ← 쓰기 큐에 쌓임\n  });\n});\n\n// FastDOM이 알아서:\n// 1. measure 콜백들을 모두 실행 (읽기)\n// 2. mutate 콜백들을 모두 실행 (쓰기)\n// 3. 레이아웃은 딱 한 번",
        "styles": {}
      }
    ],
    "children": []
  },
