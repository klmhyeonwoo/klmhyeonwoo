    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": "JavaScript → Style → Layout → Paint → Composite\n                        ↑\n                  여기서 문제가 생긴다",
        "styles": {}
      }
    ],
    "children": []
  },
  {
