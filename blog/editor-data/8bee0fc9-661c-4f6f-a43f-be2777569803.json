  {
    "id": "06c1d931-940b-4766-b78c-82eee6b3471f",
    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": "// 쓰기 작업은 rAF로 다음 프레임으로 미룬다\nfunction updateBox(element) {\n  const width = element.offsetWidth; // ← 지금 당장 읽기\n\n  requestAnimationFrame(() => {\n    element.style.width = width + 10 + 'px'; // ← 다음 프레임에 쓰기\n  });\n}",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "2401441f-3fb2-4e03-857a-7d5382cbe1ba",
    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
