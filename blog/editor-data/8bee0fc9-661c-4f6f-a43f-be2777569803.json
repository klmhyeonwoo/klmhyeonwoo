  {
    "id": "be872525-b740-4373-8813-1689877796ce",
    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": "/* ❌ 레이아웃을 유발하는 속성 */\n.box {\n  transition: width 0.3s, height 0.3s, top 0.3s, left 0.3s;\n}\n\n/* ✅ Composite 단계만 사용하는 속성 */\n.box {\n  transition: transform 0.3s, opacity 0.3s;\n  /* transform과 opacity는 레이아웃, 페인트를 건너뛴다 */\n}",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "1e62d6ac-b500-40c1-93b1-73b11efadc5c",
    "type": "paragraph",
