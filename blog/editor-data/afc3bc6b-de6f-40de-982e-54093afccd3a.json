      },
      {
        "type": "text",
        "text": "http://localhost:5173",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": "에 띄웠다고 한다면, \n아래와 같은 과정들이 일어난다.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "615b5243-9941-4915-841d-77d2f15321e1",
    "type": "numberedListItem",
    "props": {
      "backgroundColor": "default",
