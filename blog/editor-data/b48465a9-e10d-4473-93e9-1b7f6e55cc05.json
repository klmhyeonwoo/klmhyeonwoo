          "content": [
            {
              "type": "detailsSummary",
              "content": [
                {
                  "type": "text",
                  "text": " gitWorker.postMessage를 보면 buffer, [buffer] 형태로 값을 보내고 있는데, 왜 이렇게 보낼까?"
                }
              ]
            },
            {
              "type": "detailsContent",
