                      "type": "text",
                      "text": "의 구조는 대략 아래와 같이 구성이 된다."
                    }
                  ]
                },
                {
                  "type": "codeBlock",
                  "attrs": {
                    "id": "CkwimNks4cF7",
                    "language": "text"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "frames = [\n  {\n    patch: Uint8ClampedArray,\n    dims: { ... },\n  },\n]"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "attrs": {
                    "id": "hnoD8FcoUg3o",
                    "textAlign": "left"
                  },
                  "content": [
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "code"
                        }
