          "bold": true
        }
      }
    ],
    "children": []
  },
  {
    "id": "54cf9260-0e39-4073-9b5e-9b6a42a6b201",
    "type": "codeBlock",
    "props": {
      "language": "javascript"
    },
    "content": [
      {
        "type": "text",
        "text": ".card {\n  transition: transform 0.3s;   /* transform 시작 전: 스태킹 컨텍스트 없음 */\n}\n\n.card:hover {\n  transform: scale(1.05);       /* ← hover 시 스태킹 컨텍스트 생성 */\n}",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "22d5e8d1-dcf2-43fe-a58c-46cc6fb4bd7b",
    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "hover 전후로 z-index 동작이 달라진다. 평소엔 잘 쌓이다가 hover 순간에 다른 요소 뒤로 사라지는 버그가 이런 패턴에서 나온다.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "2c393718-fd0f-41ab-803f-565452e2b738",
    "type": "heading",
