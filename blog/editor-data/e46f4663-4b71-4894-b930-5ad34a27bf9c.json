      "textAlignment": "left",
      "level": 2,
      "isToggleable": false
    },
    "content": [
      {
        "type": "text",
        "text": "시작하기",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "2475f0bc-f000-49b3-aec7-fd7211f4ea00",
    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "아래 명령어를 통해 ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Lerna",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " 세팅을 손쉽게 할 수 있습니다.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
